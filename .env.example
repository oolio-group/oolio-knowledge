# Copy to .env and fill in. .env is gitignored — keep it that way.

# Supabase project oolio-tree (vcrajophxpoydfmronbi)
SUPABASE_URL=https://vcrajophxpoydfmronbi.supabase.co

# Service role key — Supabase dashboard → Project Settings → API.
# Bypasses RLS. Never commit, never paste into a chat, never put in a script.
SUPABASE_SERVICE_KEY=

# Personal access token for the Supabase MCP server (.mcp.json).
# Supabase dashboard → Account → Access Tokens. Different from the key above.
SUPABASE_ACCESS_TOKEN=

# Where the Obsidian vault lives. Article bodies are read from here.
VAULT_PATH=/Users/nielcody/my_brain
